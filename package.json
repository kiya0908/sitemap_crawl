{
  "name": "sitemap-crawl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply sitemap-crawl --local",
    "db:migrate:remote": "wrangler d1 migrations apply sitemap-crawl --remote",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "retention": "node scripts/retention.js",
    "test:retention:d1": "node scripts/test-retention-d1.js"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "fast-xml-parser": "^5.2.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "globals": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
